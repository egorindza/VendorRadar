<form class="fields" method="post" action="/account/login">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <label>Аккаунт<input name="account" autocomplete="username" maxlength="150" required /></label>
    <label>Пароль<input name="password" type="password" autocomplete="current-password" maxlength="256" required /></label>
    <button type="submit" class="button primary">Войти</button>
</form>
