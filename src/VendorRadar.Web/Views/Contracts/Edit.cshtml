@model ContractForm
@{ ViewData["Title"] = Model.Id is null ? "Новый контракт" : "Редактировать контракт"; var departments = (IReadOnlyList<Department>)ViewBag.Departments; }
<a class="back-link" href="@(Model.Id is null ? "/contracts" : $"/contracts/{Model.Id}")">‹ Контракты</a>
<section class="heading"><div><h1>@ViewData["Title"]</h1><p>Укажите полную стоимость за платёжный цикл.</p></div></section>
<form class="panel form-panel fields" method="post" action="/contracts/edit">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
    <div class="field-grid">
        <label>Название сервиса<input asp-for="Name" required /></label>
        <label>Домен<input asp-for="Domain" placeholder="example.com" required /></label>
        <label>Категория<input asp-for="Category" required /></label>
        <label>Отдел<select asp-for="DepartmentId" required><option value="">Выберите отдел</option>@foreach (var dept in departments) { <option value="@dept.Id">@dept.Name</option> }</select></label>
        <label>Стоимость за цикл<input asp-for="Cost" type="number" min="0" max="100000000" step="0.0001" required /></label>
        <label>Валюта<select asp-for="Currency" asp-items="Html.GetEnumSelectList<Currency>()"></select></label>
        <label>Цикл<select asp-for="Cycle">@foreach (var cycle in Enum.GetValues<BillingCycle>()) { <option value="@((int)cycle)">@Labels.Cycle(cycle)</option> }</select></label>
        <label>Оплаченные места<input asp-for="Seats" type="number" min="0" max="100000" required /></label>
        <label>Дата следующего платежа<input asp-for="NextPayment" type="date" required /></label>
        <label>Уведомить за, дней<input asp-for="NoticeDays" type="number" min="0" max="365" required /></label>
    </div>
    <label class="check"><input asp-for="AutoRenew" /> Автопродление действует</label>
    <label class="check"><input asp-for="Active" /> Договор действует</label>
    <div class="actions"><button class="button primary">Сохранить</button><a class="button secondary" href="/contracts">Отмена</a></div>
</form>
