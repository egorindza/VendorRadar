@model IReadOnlyList<Contract>
@inject TimeProvider Clock
@{ var today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime); }
@if (Model.Count == 0)
{
    <p class="empty" role="status">Контракты не найдены.</p>
}
else
{
    <div class="table-wrap"><table>
        <thead><tr><th>Сервис</th><th>Отдел</th><th>Стоимость</th><th>Места</th><th>Следующее списание</th><th>Уведомить до</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            DateOnly? next = BusinessRules.Payments(item, today, today.AddYears(1)).Cast<DateOnly?>().FirstOrDefault();
            <tr><td><a class="entity-link" href="/contracts/@item.Id"><span class="tile service">@item.Name[0]</span><span><strong>@item.Name</strong><small>@item.Domain</small></span></a></td>
                <td>@item.Department.Name</td><td><strong>@item.Cost.ToString("N2") @item.Currency</strong><small>@Labels.Cycle(item.Cycle)</small></td>
                <td>@item.Seats</td><td>@(next?.ToString("dd.MM.yyyy") ?? "—")</td>
                <td>@if (item.AutoRenew) { <span class="badge neutral">@(next?.AddDays(-item.NoticeDays).ToString("dd.MM.yyyy") ?? "—")</span> } else { <span class="muted">Отключено</span> }</td>
            </tr>
        }
        </tbody>
    </table></div>
}
