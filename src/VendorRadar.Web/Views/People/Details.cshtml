@model EmployeeDetails
@{ ViewData["Title"] = Model.Employee.Name; var employee = Model.Employee; var security = User.IsInRole(Roles.Security); }
<a class="back-link" href="/people">‹ Матрица доступов</a>
<section class="heading"><div><div class="eyebrow subtle">@employee.Department.Name · @Labels.Person(employee.Status)</div><h1>@employee.Name</h1><p>@employee.Job · @employee.Email</p></div>
    @if (security && employee.Status is EmployeeStatus.Active or EmployeeStatus.Onboarding)
    {
        <form method="post" action="/people/@employee.Id/offboard">@Html.AntiForgeryToken()<button class="button danger-button">Запустить оффбординг</button></form>
    }
</section>
@if (Model.Runs.Count > 0)
{
    <section class="panel section-gap"><div class="panel-head"><h2>Чек-листы</h2></div>
    @foreach (var run in Model.Runs) { <a class="radar-row" href="/people/runs/@run.Id"><span class="tile lavender">✓</span><span class="radar-name"><strong>@Labels.Run(run.Kind)</strong><small>@run.StartedAt.ToString("dd.MM.yyyy HH:mm") UTC</small></span><span class="badge neutral">@run.Tasks.Count(x => x.CompletedAt is not null) @(run.Tasks.Count == 0 ? "" : $"/ {run.Tasks.Count}")</span></a> }
    </section>
}
<section class="panel"><div class="panel-head"><div><h2>Доступы сотрудника</h2><p>Учетные записи и идентификаторы ключей.</p></div></div>
@if (Model.Grants.Count == 0) { <p class="empty">Доступов пока нет.</p> }
else
{
    <div class="table-wrap"><table><thead><tr><th>Сервис</th><th>Тип</th><th>Роль</th><th>Активность UTC</th><th>Статус</th>
    @if (security && employee.Status == EmployeeStatus.Active) { <th>Действия</th> }</tr></thead>
    <tbody>@foreach (var grant in Model.Grants)
    {
        <tr><td><a class="text-link" href="/contracts/@grant.ContractId">@grant.Contract.Name</a></td><td>@(grant.Kind == AccessKind.ApiKey ? $"API · {grant.AssetLabel}" : "Лицензия")</td>
        <td><span class="badge info">@grant.Role</span></td><td>@(grant.LastUsedAt?.ToString("dd.MM.yyyy") ?? "Нет отметки")</td>
        <td><span class="badge @(grant.RevokedAt is null ? "positive" : "neutral")">@(grant.RevokedAt is null ? "Действует" : "Отозван")</span></td>
        @if (security && employee.Status == EmployeeStatus.Active) { <td>
            @if (grant.RevokedAt is null) { <form class="actions" method="post" action="/people/@employee.Id/grants/@grant.Id">@Html.AntiForgeryToken()<button class="button small secondary" name="action" value="used">Активность</button><button class="button small danger-button" name="action" value="revoke">Подтвердить отзыв</button></form> }
        </td> }</tr>
    }</tbody></table></div>
}
</section>
<div class="overview-grid spaced">
<section class="panel"><div class="panel-head"><div><h2>Аудит изменений</h2><p>История выдачи, изменения и отзыва прав.</p></div></div>
@if (Model.History.Count == 0) { <p class="empty">Истории пока нет.</p> }
@foreach (var version in Model.History)
{
    <div class="radar-row"><span class="tile service">@version.Name[0]</span><span class="radar-name"><strong>@version.Name · @version.Role</strong><small>@version.ValidFrom.ToString("dd.MM.yyyy HH:mm") UTC · @version.ChangedBy</small></span><span class="badge neutral">@(version.RevokedAt is null ? "Выдан / изменён" : "Отозван")</span></div>
}
</section>
@if (security && employee.Status == EmployeeStatus.Active)
{
    <form class="panel form-panel fields" action="/people/grants" method="post">
        @Html.AntiForgeryToken()
        <input name="employeeId" type="hidden" value="@employee.Id" />
        <h2>Записать доступ</h2>
        <label>Сервис<select name="contractId" required><option value="">Выберите сервис</option>@foreach (var service in Model.Services) { <option value="@service.Id">@service.Name</option> }</select></label>
        <label>Роль<select name="role">@foreach (var role in Enum.GetValues<AccessRole>()) { <option>@role</option> }</select></label>
        <label>Тип<select name="kind"><option value="Seat">Лицензия</option><option value="ApiKey">API-ключ</option></select></label>
        <label>Идентификатор ключа<input name="label" maxlength="100" placeholder="Например, CI deploy token" /><small>Укажите название ключа без его секретного значения.</small></label>
        <div><button class="button primary">Сохранить</button></div>
    </form>
}
</div>
